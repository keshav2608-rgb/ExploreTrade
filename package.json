{
  "name": "portfoliopulse",
  "version": "1.0.0",
  "private": true,
  "description": "Personal investment portfolio tracker and market insights dashboard for Indian listed equities.",
  "scripts": {
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx scripts/alert-worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "bcryptjs": "2.4.3",
    "decimal.js": "10.4.3",
    "lucide-react": "0.469.0",
    "next": "15.1.6",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "8.4.49",
    "prisma": "6.3.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
