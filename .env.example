# Copy this file to .env and fill in real values. Never commit .env.

# Database. SQLite needs no server and is the default for local use.
# For PostgreSQL: change `provider = "sqlite"` to `"postgresql"` in
# prisma/schema.prisma and set e.g. postgresql://user:pass@host:5432/portfoliopulse
DATABASE_URL="file:./dev.db"

# Auth.js session signing secret. Generate one with:  npx auth secret
# (any long random string works)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"

# Market data provider: "demo" (seeded fixtures, labelled DEMO, no network)
# or "yahoo" (Yahoo Finance via yahoo-finance2; quotes are DELAYED, not live).
MARKET_DATA_PROVIDER="demo"

# A quote older than this many minutes is shown with a stale-data warning.
QUOTE_FRESHNESS_MINUTES="20"

# Shared secret the scheduled worker sends to /api/cron/check-alerts.
CRON_SECRET="change-me-too"

# How often the local worker refreshes quotes and checks alerts (seconds).
WORKER_INTERVAL_SECONDS="300"

# Optional live feed (services/pulsefeed, Rust). Leave unset to run without it:
# the dashboard then polls on page load as usual. When set, the dashboard
# connects to the feed over WebSocket for live totals.
# PULSEFEED_WS_URL="ws://127.0.0.1:8790"
# PULSEFEED_PROVIDER="yahoo"          # or "demo"
# PULSEFEED_POLL_SECONDS="60"
# CLICKHOUSE_URL=""                   # e.g. http://127.0.0.1:8123 to mirror ticks
